---
import { type CollectionEntry, getCollection, render } from "astro:content";
import { SITE_AUTHOR } from "../../consts.ts";
import Container from "../../components/Container.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { isWritingVisible } from "../../utils/writings.ts";
import { formatCalendarDate } from "../../utils/calendar-date";

export async function getStaticPaths() {
  const posts = (await getCollection("writings")).filter(isWritingVisible);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: post,
  }));
}
type Props = CollectionEntry<"writings">;

const post = Astro.props;
const { Content } = await render(post);
const { title, description, pubDate, updatedDate } = post.data;
---
<BaseLayout
  metadata={{
        title: `${title} - ${SITE_AUTHOR}`,
        description,
        type: "article",
        publicationDate: pubDate,
        modificationDate: updatedDate,
    }}
>
  <Container class="mb-16 pt-32">
    <article class="mx-auto max-w-160">
      <header class="mb-16 pt-12">
        <h1 class="type-page-title mb-2">{title}</h1>
        <time datetime={pubDate}
          class="type-metadata font-light text-ink-dim">{formatCalendarDate(pubDate)}</time>
      </header>
      <div class="prose">
        <Content />
      </div>
    </article>
  </Container>
</BaseLayout>

<script is:inline src="/copy-code.js"></script>
