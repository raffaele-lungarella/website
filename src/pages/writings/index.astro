---
import { getCollection } from "astro:content";
import Container from "../../components/Container.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE_AUTHOR } from "../../consts.ts";
import { getCalendarYear } from "../../utils/calendar-date.ts";
import { isWritingVisible } from "../../utils/writings.ts";
import { formatCalendarDate } from "../../utils/calendar-date.ts";

const writings = (await getCollection("writings"))
  .filter(isWritingVisible)
  .sort((a, b) => b.data.pubDate.localeCompare(a.data.pubDate));

const writingsByYear = writings.reduce((groups, post) => {
  const year = getCalendarYear(post.data.pubDate);
  const posts = groups.get(year) ?? [];

  posts.push(post);
  groups.set(year, posts);

  return groups;
}, new Map<number, typeof writings>());
---
<BaseLayout
  metadata={{
        title: `Writings - ${SITE_AUTHOR}`,
        description: `Writing about software and design by ${SITE_AUTHOR}.`,
    }}
>
  <Container class="mb-8 pt-32">
    <div class="mx-auto flex w-full max-w-[640px] flex-col">
      <h1
        class="type-section-title font-light border-b border-edge py-1">Writings</h1>
      <section>
        {
            writings.length === 0 ? (
                <div class="flex flex-col items-center justify-center text-center font-serif">
                    <p class="text-ink-dim text-lg font-sans">Nothing here yet.</p>
                </div>
            ) : (
                <div class="mt-8 flex flex-col gap-10">
                    {[...writingsByYear.entries()].map(([year, posts]) => (
                        <section>
                            <h2 class="type-section-title font-light text-ink-dim border-b border-edge pb-2">
                                {year}
                            </h2>
                            <ul class="m-0 flex flex-col p-0">
                                {posts.map((post) => (
                                <li class="group list-none border-b border-edge">
                                    <a
                                        href={`/writings/${post.id}/`}
                                        class="flex items-baseline gap-3 py-2 text-ink no-underline interactive focus-visible:bg-ui-hover"
                                    >
                                        <span
                                            aria-hidden="true"
                                            class="size-4 shrink-0 self-center bg-current opacity-0 w-0 group-hover:w-4 group-hover:opacity-100 transition-all duration-200 ease-out origin-left"
                                        />
                                        <h3 class="m-0 min-w-0 flex-1 font-normal">
                                            {post.data.title}
                                        </h3>

                                        <span class="shrink-0 whitespace-nowrap text-ink-dim">
                                            {formatCalendarDate(post.data.pubDate)}
                                        </span>
                                    </a>
                                </li>
                                ))}
                            </ul>
                        </section>
                    ))}
                </div>
            )
        }
    </section>
    </div>
  </Container>
</BaseLayout>
