---
import Container from "../components/Container.astro";
import Link from "../components/Link.astro";
import { SITE_AUTHOR } from "../consts";
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout metadata={{ title: SITE_AUTHOR }}>
  <Container class="py-12 sm:py-20">
    <div
      class="mx-auto grid items-center justify-items-center gap-12 md:grid-cols-[minmax(0,5fr)_minmax(0,4fr)]">
      <figure
        class="photo-card w-full max-w-64 rotate-1 bg-[#fdfdfc] p-3 pb-6 shadow-[0_2px_3px_rgb(0_0_0/0.12),0_5px_8px_-3px_rgb(0_0_0/0.18)] rounded-xs sm:max-w-80 md:order-2">
        <picture>
          <source srcset="/tree.avif" type="image/avif" />
          <img src="/tree.webp"
            alt="Umbrella pines and cypress trees overlooking the Tuscan countryside"
            width="1428" height="1904" decoding="async"
            class="aspect-4/5 w-full object-cover" />
        </picture>
        <figcaption
          class="mt-4 px-1 text-center type-metadata text-neutral-600">A quiet corner of Tuscany, not far from home.</figcaption>
      </figure>
      <div class="intro-text w-full text-left text-lg font-normal md:order-1">
        <p
          class="text-ink-dim">I'm <span class="text-ink">Raffaele</span>, a developer based in Firenze, Italy. I made this site to get better at writing and because I love yapping about software.</p>

        <br />
        <p class="text-ink-dim">
            Currently working at <Link variant="underline" href={"https://bricks.sh/next-gen"}> bricks.sh</Link>
          </p>
        <br />
        <p class="mt-8">
          <span class="text-ink-dim">/</span><Link
            variant="underline"
            href="/writings/">writings</Link
          >
        </p>
      </div>
    </div>
  </Container>
</BaseLayout>

<style>
.photo-card {
  animation: reveal-photo 1s cubic-bezier(0.22, 1, 0.36, 1) both;
  will-change: opacity, filter, transform;
}

.intro-text {
  animation: reveal-text 800ms cubic-bezier(0.22, 1, 0.36, 1) 120ms both;
  will-change: opacity, filter, transform;
}

@keyframes reveal-photo {
  from {
    opacity: 0;
    filter: blur(8px) saturate(0.6);
    transform: translateY(-12px) rotate(4deg) scale(1.03);
  }

  to {
    opacity: 1;
    filter: blur(0) saturate(1);
    transform: translateY(0) rotate(1deg) scale(1);
  }
}

@keyframes reveal-text {
  from {
    opacity: 0;
    filter: blur(10px);
    transform: translateY(8px);
  }

  to {
    opacity: 1;
    filter: blur(0);
    transform: translateY(0);
  }
}

@media (prefers-reduced-motion: reduce) {
  .photo-card,
  .intro-text {
    animation: none;
    will-change: auto;
  }

  .photo-card {
    opacity: 1;
  }
}
</style>
